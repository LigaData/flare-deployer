# Kubernetes-app listing settings. Copy to marketplace.env and fill in. The product has its own
# Producer Portal entry, repository, service name and consumption-tracking label.
MP_PROJECT=ligadata-public              # Marketplace producer project
MP_REPO=ligadata-flare                  # Artifact Registry repository = product ID (us-docker.pkg.dev/ligadata-public/ligadata-flare)
MP_TRACK=4.1                            # release track; deployer and images carry this tag
MP_VERSION=4.1.0                        # publishedVersion in schema.yaml; second image tag
MP_SERVICE_NAME=services/ligadata-flare.endpoints.ligadata-public.cloud.goog   # from the product's Overview page
MP_SOLUTION_URN=                        # consumption tracking label value from the product's Overview page
SRC_REPO=us-docker.pkg.dev/ligadata-public/ligadata-dataflare   # LigaData staging repository the product images are copied from
